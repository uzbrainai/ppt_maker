# Web app environment. Copy to `.env` and adjust.

# Auth backend base URL (JWT). Leave empty to use the local mock session.
VITE_API_BASE=

# slidewind PPTX generation service (docker-compose, src/services/server.ts).
# Start it from the repo root:  docker compose --env-file .env up -d
# Then point the web app at it. Leave empty to fall back to the local mock generator.
VITE_SLIDEWIND_BASE=http://localhost:8081

# Google Sign-In client ID (same as root .env GOOGLE_CLIENT_ID). Required for
# the Continue with Google button. In Docker this is passed as a build arg.
VITE_GOOGLE_CLIENT_ID=

# Optional shared-token auth — must match SLIDEWIND_TOKEN in the service's env.
VITE_SLIDEWIND_TOKEN=
