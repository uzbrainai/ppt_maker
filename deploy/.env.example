# ─────────────────────────────────────────────────────────────────────────────
# slidewind — production environment. Copy to the REPO ROOT as `.env`:
#     cp deploy/.env.example .env   &&   nano .env
# The generation service loads this file automatically (agent/env.ts → loadEnv).
# Never commit the real .env (it's in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...                 # content + design agents (and image fallback)
TAVILY_API_KEY=tvly-...               # primary research provider (web search)

# ── Models (optional — sensible defaults shown) ─────────────────────────────
OPENAI_MODEL=gpt-4.1-mini             # content/design agent model
OPENAI_SEARCH_MODEL=gpt-4o-search-preview   # OpenAI web-search fallback model
OPENAI_IMAGE_MODEL=gpt-image-1        # premium AI photos (only if Premium tier used)

# ── Research tuning (optional) ──────────────────────────────────────────────
TAVILY_SEARCH_DEPTH=basic             # basic = 1 credit/search (advanced = 2)
TAVILY_MAX_RESULTS=5                  # URLs per deck
TAVILY_TIMEOUT_MS=15000
RESEARCH_PRIMARY_TIMEOUT_MS=12000     # cap on the OpenAI-search fallback
# BRAVE_API_KEY=                      # optional extra keyless-ish fallback

# ── Service (optional) ──────────────────────────────────────────────────────
SLIDEWIND_PORT=8081                   # bound to 127.0.0.1; nginx proxies /api → here
# SLIDEWIND_TOKEN=                    # if set, server-to-server calls send it as x-api-key
# CORS_ORIGIN=https://your-domain.com # only needed if the API is on a different origin
# OUT_DIR=/var/www/slidewind/out      # also write generated .pptx to disk (optional)
NODE_ENV=production

# ── Auth (JWT) ──────────────────────────────────────────────────────────────
# When AUTH_REQUIRED=true, the API rejects requests without a valid Bearer JWT.
AUTH_REQUIRED=false
JWT_SECRET=__generate_a_long_random_hex_secret__

# ── PostgreSQL (required for login / register / credits / materials) ────────
POSTGRES_USER=sw
POSTGRES_PASSWORD=__strong_password__
POSTGRES_DB=slidewind
# Host-side URL for `npm run serve`. Docker Compose ignores this and uses the
# `db` service instead (postgres://USER:PASSWORD@db:5432/DB).
DATABASE_URL=postgres://sw:__strong_password__@localhost:5432/slidewind

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=__change_me__

# Google Sign-In — OAuth 2.0 Web client ID (Google Cloud Console → Credentials).
# Add Authorized JavaScript origins: http://localhost:8080 and your prod origin.
# Rebuild the `web` image after changing this (baked in as VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# ── Click.uz payments (Shop API — payment page + prepare/complete webhook) ───
# Fill these from the Click merchant cabinet, then set BOTH Prepare URL and
# Complete URL to:  {PUBLIC_API_URL}/payments/click
# e.g. https://make-ppt.com/api/payments/click
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
# CLICK_MERCHANT_USER_ID=           # optional (Merchant API only)
# CLICK_PRICE_PRO_UZS=229000        # UZS amount for Pro
# CLICK_PRICE_TEAM_UZS=590000       # UZS amount for Team
PUBLIC_WEB_URL=https://make-ppt.com
PUBLIC_API_URL=https://make-ppt.com/api

# ── Email verification (optional; without SMTP the code is logged to console) ─
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# ── Admin panel (front/admin) ───────────────────────────────────────────────
# Separate SPA on its own port. Sign in with the seed ADMIN_EMAIL / ADMIN_PASSWORD.
ADMIN_PORT=8083
# VITE_ADMIN_API_BASE=/api
# VITE_ADMIN_BASE=/
