{
  "name": "slidewind",
  "version": "0.1.0",
  "description": "Tailwind CSS for editable PowerPoint generation. Compact DeckSpec Lite expands into rich, editable PPTX (OOXML) objects.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pptx",
    "powerpoint",
    "ooxml",
    "slides",
    "presentation",
    "tailwind",
    "llm",
    "editable"
  ],
  "bin": {
    "slidewind": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "serve": "tsx src/services/server.ts",
    "dev": "tsx src/cli.ts",
    "slidewind": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx src/cli.ts build examples/deck.yaml -o examples/out/demo.pptx --preview"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^9.1.0",
    "fastify": "^5.8.5",
    "jszip": "^3.10.1",
    "lucide-static": "^1.18.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}
