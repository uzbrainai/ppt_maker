# =============================================================================
# Slidewind — muhit o'zgaruvchilari
# Nusxa oling:  cp .env.example .env  va kerakli qiymatlarni kiriting.
# Hech qachon haqiqiy .env faylini git'ga commit qilmang!
# =============================================================================

# ── MAJBURIY ────────────────────────────────────────────────────────────────
# OpenAI API kaliti — kontent/dizayn agentlari va rasm generatsiya uchun
OPENAI_API_KEY=sk-...

# Tavily API kaliti — veb-qidiruv (tadqiqot) uchun
TAVILY_API_KEY=tvly-...

# ── AI MODELLARI (ixtiyoriy — sukut bo'yicha qiymatlari ko'rsatilgan) ───────
# Kontent va dizayn agenti uchun model
OPENAI_MODEL=gpt-4.1-mini

# OpenAI veb-qidiruv modeli (fallback sifatida)
OPENAI_SEARCH_MODEL=gpt-4o-search-preview

# Premium rasm generatsiya modeli (faqat Premium rejimda ishlatiladi)
OPENAI_IMAGE_MODEL=gpt-image-1

# ── TADQIQOT SOZLAMALARI (ixtiyoriy) ───────────────────────────────────────
# Qidiruv chuqurligi: basic = 1 kredit, advanced = 2 kredit
TAVILY_SEARCH_DEPTH=basic

# Har bir qidiruvda qaytariladigan URL soni
TAVILY_MAX_RESULTS=5

# Tavily so'rovlari uchun kutish vaqti (ms)
TAVILY_TIMEOUT_MS=15000

# OpenAI-search fallback uchun kutish vaqti (ms)
RESEARCH_PRIMARY_TIMEOUT_MS=12000

# Brave Search API — qo'shimcha zaxira qidiruv (ixtiyoriy)
# BRAVE_API_KEY=

# ── ASOSIY SERVIS ──────────────────────────────────────────────────────────
# API server porti
SLIDEWIND_PORT=8081

# Server bog'lanadigan host/interfeys
SLIDEWIND_HOST=0.0.0.0

# Server-to-server autentifikatsiya tokeni (ixtiyoriy)
# SLIDEWIND_TOKEN=

# Admin operatsiyalari uchun token (x-admin-key header orqali)
# ADMIN_TOKEN=

# CORS uchun ruxsat etilgan origin (faqat cross-origin bo'lsa kerak)
# CORS_ORIGIN=https://your-domain.com

# Yaratilgan .pptx fayllarni diskka yozish papkasi (ixtiyoriy)
# OUT_DIR=/var/www/slidewind/out

# Bitta so'rovda maksimal slaydlar soni
MAX_PAGES=40

# Node muhiti
NODE_ENV=production

# ── AUTENTIFIKATSIYA (JWT) ─────────────────────────────────────────────────
# true bo'lsa, barcha API so'rovlari JWT talab qiladi
AUTH_REQUIRED=false

# JWT imzolash kaliti — uzun tasodifiy hex string kiriting!
JWT_SECRET=__generate_a_long_random_hex_secret__

# JWT muddati (masalan: 7d, 24h, 30m)
JWT_TTL=7d

# ── POSTGRESQL MA'LUMOTLAR BAZASI ──────────────────────────────────────────
# Bazasiz ham ishlaydi (kreditlar, foydalanuvchilar, saqlash bo'lmaydi)
POSTGRES_USER=sw
POSTGRES_PASSWORD=__kuchli_parol__
POSTGRES_DB=slidewind
POSTGRES_PORT=5432

# To'liq ulanish URL (lokal ishga tushirishda shu)
DATABASE_URL=postgres://sw:__kuchli_parol__@localhost:5432/slidewind

# Ulanishlar puli hajmi
DATABASE_POOL_MAX=10

# SSL yoqish (production uchun)
# DATABASE_SSL=true

# Oylik bepul kreditlar soni (har bir foydalanuvchi uchun)
FREE_MONTHLY_CREDITS=20

# ── ADMIN HISOB ────────────────────────────────────────────────────────────
# Boshlang'ich admin foydalanuvchi (server birinchi ishga tushganda yaratiladi)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=__o'zgartiring__

# ── GOOGLE OAUTH ───────────────────────────────────────────────────────────
# Google Cloud Console → Credentials dan olingan Web client ID
GOOGLE_CLIENT_ID=

# ── CLICK.UZ TO'LOV TIZIMI ────────────────────────────────────────────────
# Click merchant kabinetidan olinadi
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
# CLICK_MERCHANT_USER_ID=

# Narxlar (UZS)
CLICK_PRICE_PRO_UZS=229000
CLICK_PRICE_TEAM_UZS=590000

# Ommaviy URL'lar (to'lov callback va email havolalari uchun)
PUBLIC_WEB_URL=https://make-ppt.com
PUBLIC_API_URL=https://make-ppt.com/api

# ── EMAIL (SMTP) ──────────────────────────────────────────────────────────
# SMTP sozlanmasa, tasdiqlash kodi konsolga chiqariladi
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# SMTP_FROM=                            # sukut bo'yicha SMTP_USER ishlatiladi

# Email tasdiqlash kodi amal qilish muddati (daqiqa)
EMAIL_CODE_TTL_MINUTES=15

# Maksimal tasdiqlash urinishlari
EMAIL_MAX_ATTEMPTS=5

# ── RASM SERVISI (Premium) ────────────────────────────────────────────────
# Alohida rasm generatsiya mikroservisi (imagesvc, port 8082)
# IMAGE_SERVICE_URL=http://localhost:8082

# Rasm servisi autentifikatsiya tokeni
# IMAGE_SVC_TOKEN=

# Rasm servisi porti
IMAGE_SVC_PORT=8082

# Bir vaqtda generatsiya qilinadigan rasmlar soni
IMAGE_SVC_CONCURRENCY=3

# Rasm keshi papkasi
IMAGE_CACHE_DIR=.imgcache

# ── PDF EKSPORT ────────────────────────────────────────────────────────────
# LibreOffice yo'li (avtomatik aniqlanadi, lekin qo'lda ko'rsatish mumkin)
# SOFFICE_BIN=/usr/bin/soffice

# ── DOCKER COMPOSE PORTLARI ───────────────────────────────────────────────
# Web SPA uchun host porti
WEB_PORT=8080

# Admin panel uchun host porti
ADMIN_PORT=8083

# ── FRONTEND (Vite build-time) ─────────────────────────────────────────────
# Bu o'zgaruvchilar front/web/.env ga yoziladi (yoki Docker build arg sifatida)
# VITE_SLIDEWIND_BASE=http://localhost:8081
# VITE_API_BASE=
# VITE_GOOGLE_CLIENT_ID=
# VITE_BASE=/
