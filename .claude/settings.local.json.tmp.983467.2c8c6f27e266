{
  "permissions": {
    "allow": [
      "Bash(npm install *)",
      "Bash(npx vitest *)",
      "Bash(IMAGE_CACHE_DIR=__TRACKED_VAR__/.imgcache node dist/cli.js generate --topic 'The future of electric vehicles' --lang en --theme dark.tech --mode dark --pages 8 --premium --image-pct 40 --image-quality medium --model gpt-4o --env /tmp/slidewind.env -o /tmp/evcost.pptx)",
      "Bash(docker compose *)",
      "Bash(/usr/bin/curl -s http://localhost:8081/health)",
      "Bash(/usr/bin/curl -s http://localhost:8082/health)",
      "Bash(/usr/bin/curl -s http://localhost:8081/generate -H 'content-type: application/json' -d '{\"topic\":\"The future of electric vehicles\",\"theme\":\"dark.tech\",\"mode\":\"dark\",\"pages\":8,\"premium\":true,\"imagePct\":40}' -o /tmp/apiresp.json -w 'HTTP %{http_code} %{time_total}s\\\\n')",
      "Bash(python3 -c ' *)",
      "Bash(/usr/bin/curl -sL -A \"Mozilla/5.0\" \"https://perceptis.ai/slide-templates\" -o perceptis.html -w \"HTTP %{http_code}, %{size_download}b, %{content_type}\\\\n\")",
      "Bash(/usr/bin/head -c 1500 perceptis.html)",
      "Bash(python3 -)",
      "Bash(awk '{print $5}')",
      "Bash(npx tsc *)",
      "Bash(echo \"exit: $?\")",
      "Bash(pm2 list *)",
      "Bash(curl -s http://127.0.0.1:8091/health)",
      "Bash(git init *)",
      "Bash(git remote *)",
      "Bash(git symbolic-ref *)",
      "Bash(git branch *)",
      "Bash(git add *)"
    ],
    "additionalDirectories": [
      "/tmp"
    ]
  }
}
